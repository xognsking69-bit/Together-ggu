{
  "name": "trip-split-receipt-ai-v2",
  "compatibility_date": "2026-09-10",
  "main": "worker/receipt-ai-worker.js",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "RECEIPT_AI_PROVIDER": "cloudflare",
    "RECEIPT_AI_MODEL": "@cf/moondream/moondream3.1-9B-A2B",
    "MAX_ANALYSES_PER_GUEST_PER_DAY": "10",
    "MAX_ANALYSES_GLOBAL_PER_DAY": "10",
    "RECEIPT_CREDITS_ENABLED": "false",
    "RECEIPT_PAID_ANALYSIS_ENABLED": "false",
    "RECEIPT_SALES_SANDBOX_VERIFIED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RECEIPT_USAGE",
        "class_name": "ReceiptUsageStore"
      },
      {
        "name": "RECEIPT_CREDIT_LEDGER",
        "class_name": "ReceiptCreditLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReceiptUsageStore"
      ]
    },
    {
      "tag": "v2-receipt-credits",
      "new_sqlite_classes": [
        "ReceiptCreditLedger"
      ]
    }
  ]
}
